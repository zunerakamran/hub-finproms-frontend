# Local development — use relative /api so Vite proxies to Laravel (httpOnly cookies).
# Vite proxy target: http://127.0.0.1:8000 (see vite.config.js)
VITE_API_URL=/api
VITE_WC_TEMPLATE_PREVIEW_URL=https://epatronus.space

# Production builds (.env.production): prefer same-origin /api when the SPA and
# Laravel share a host (e.g. https://sharedhub.fin-proms.com + /api).
# Cross-origin APIs need SESSION_SAME_SITE=none + Secure cookies on the backend.
# VITE_API_URL=/api
# VITE_API_URL=https://sharedhub.fin-proms.com/api
