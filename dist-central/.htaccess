<IfModule mod_rewrite.c>
  RewriteEngine On

  # Already the real file path — stop here (prevents rewrite loops / 500)
  RewriteRule ^api/storage/app/public/ - [L]

  # Map public asset URLs to the real disk folder under the Laravel app
  RewriteRule ^storage/(.*)$ api/storage/app/public/$1 [L]
  RewriteRule ^api/storage/(.*)$ api/storage/app/public/$1 [L]

  # Never SPA-fallback Vite build assets — missing files must 404 as JS, not HTML
  RewriteRule ^assets/ - [L]

  # Laravel API
  RewriteCond %{REQUEST_URI} ^/api
  RewriteRule ^api(?:/(.*))?$ api/public/index.php [L,QSA]

  # Frontend SPA — keep real files; send other routes to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Correct MIME types so browsers accept module scripts
<IfModule mod_mime.c>
  AddType text/javascript .js .mjs
  AddType application/wasm .wasm
  AddType text/css .css
</IfModule>

# Avoid stale index.html pointing at deleted hashed chunks after deploy
<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(js|css|wasm|png|jpg|jpeg|gif|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
